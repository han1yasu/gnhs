# GNHS Guidance System — Production Apache Configuration
<IfModule mod_rewrite.c>
RewriteEngine On

# Redirect domain root visits directly to /gnhs-guidance/
RewriteRule ^$ /gnhs-guidance/ [L,R=301]

# Uploads fallback rewrites
RewriteCond %{REQUEST_URI} ^/gnhs-guidance/uploads/(.*)$
RewriteCond %{DOCUMENT_ROOT}/uploads/%1 -f
RewriteRule ^gnhs-guidance/uploads/(.*)$ /uploads/$1 [L]

RewriteCond %{REQUEST_URI} ^/uploads/(.*)$
RewriteCond %{DOCUMENT_ROOT}/gnhs-guidance/uploads/%1 -f
RewriteRule ^uploads/(.*)$ /gnhs-guidance/uploads/$1 [L]
</IfModule>

# Protect sensitive files
<FilesMatch "^(env\.php|\.env|.*\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>
